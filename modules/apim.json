        "value": "[format('<policies>\n  <inbound>\n    <base />\n    <set-backend-service base-url=\"https://{0}/api\" />\n  </inbound>\n  <backend>\n    <base />\n  </backend>\n  <outbound>\n    <base />\n  </outbound>\n  <on-error>\n    <base />\n  </on-error>\n</policies>\n', parameters('functionAppHostName'))]"
      },
