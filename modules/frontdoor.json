{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "16946540636994589369"
    }
  },
  "parameters": {
    "env": {
      "type": "string",
      "metadata": {
        "description": "環境識別子"
      }
    },
    "projectName": {
      "type": "string",
      "metadata": {
        "description": "プロジェクト名"
      }
    },
    "appGwPublicIp": {
      "type": "string",
      "metadata": {
        "description": "Application Gateway のパブリック IP アドレス"
      }
    }
  },
  "variables": {
    "frontDoorName": "[format('afd-{0}-{1}', parameters('projectName'), parameters('env'))]",
    "endpointName": "[format('ep-{0}-{1}', parameters('projectName'), parameters('env'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Cdn/profiles",
      "apiVersion": "2023-05-01",
      "name": "[variables('frontDoorName')]",
      "location": "Global",
      "sku": {
        "name": "Premium_AzureFrontDoor"
      },
      "properties": {
        "originResponseTimeoutSeconds": 60
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('frontDoorName'), variables('endpointName'))]",
      "location": "Global",
      "properties": {
        "enabledState": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('frontDoorName'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('frontDoorName'), 'appgw-origin-group')]",
      "properties": {
        "loadBalancingSettings": {
          "sampleSize": 4,
          "successfulSamplesRequired": 3,
          "additionalLatencyInMilliseconds": 50
        },
        "healthProbeSettings": {
          "probePath": "/",
          "probeRequestType": "GET",
          "probeProtocol": "Http",
          "probeIntervalInSeconds": 100
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('frontDoorName'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups/origins",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('frontDoorName'), 'appgw-origin-group', 'appgw-origin')]",
      "properties": {
        "hostName": "[parameters('appGwPublicIp')]",
        "httpPort": 80,
        "httpsPort": 443,
        "originHostHeader": "[parameters('appGwPublicIp')]",
        "priority": 1,
        "weight": 1000,
        "enabledState": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('frontDoorName'), 'appgw-origin-group')]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('frontDoorName'), variables('endpointName'), 'default-route')]",
      "properties": {
        "originGroup": {
          "id": "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('frontDoorName'), 'appgw-origin-group')]"
        },
        "supportedProtocols": [
          "Http",
          "Https"
        ],
        "patternsToMatch": [
          "/*"
        ],
        "forwardingProtocol": "HttpOnly",
        "linkToDefaultDomain": "Enabled",
        "httpsRedirect": "Disabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', variables('frontDoorName'), variables('endpointName'))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups/origins', variables('frontDoorName'), 'appgw-origin-group', 'appgw-origin')]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('frontDoorName'), 'appgw-origin-group')]"
      ]
    }
  ],
  "outputs": {
    "frontDoorId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Cdn/profiles', variables('frontDoorName'))]"
    },
    "frontDoorName": {
      "type": "string",
      "value": "[variables('frontDoorName')]"
    },
    "frontDoorEndpointUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', variables('frontDoorName'), variables('endpointName')), '2023-05-01').hostName)]"
    },
    "frontDoorEndpointHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', variables('frontDoorName'), variables('endpointName')), '2023-05-01').hostName]"
    }
  }
}